<Project>
  <!--
    Static assets of projects / packages that don't use the static web assets SDK (e.g. Serenity.Corelib).

    Library side:
    - SerenityStaticAssetsEnabled defaults to true for libraries that don't use static web assets
      (StaticWebAssetsEnabled is not true). Set it to false to opt out.
    - The files are SerenityStaticAssetIncludes (defaults to wwwroot\**, can be set to a whitelist of
      patterns under wwwroot) minus SerenityStaticAssetDefaultExcludes (the SDK's DefaultItemExcludes and
      DefaultExcludesInProjectFolder like for default Content items, plus dot / temp files; wwwroot\.well-known
      is kept like the SDK does, when includes are not customized) and SerenityStaticAssetExcludes
      (project relative patterns, for library specific exclusions).
      Their paths are relative to wwwroot. While running from the build output, the whole wwwroot is served.
    - They are served / published by referencing web apps under StaticWebAssetBasePath (the same property
      the static web assets SDK uses, so switching between the two keeps the URLs; leading / optional),
      or the assembly name if it is not set.
    - Packing puts the files under staticwebassets\ and adds a buildTransitive\[PackageId].props that
      declares the folder as a SerenityStaticAssetRoot item for consuming apps.

    Application side (OutputType Exe):
    - build: writes [AssemblyName].serenitystaticassets.json listing the folders of referenced projects
      and packages, copied to the output directory but not published, which Serenity.Web.SerenityStaticAssets
      uses to serve the files under their base paths while running from the build output
      (see UseSerenityStaticAssets)
    - publish: copies the files to wwwroot\[BasePath]\
    - publish: creates .br / .gz files for wwwroot files to publish, using the static web assets SDK's compression
      properties (see _CompressSerenityPublishFiles)
    - when StaticWebAssetsEnabled is false for the app, warns about packages (SERSA001) and referenced
      projects (SERSA002) that still use static web assets, unless SerenityStaticWebAssetsCheck is false.
      referenced projects are only detected if they import these targets (e.g. via Serenity.Net.Web).
  -->
  <Target Name="_InitSerenityStaticAssets">
    <PropertyGroup>
      <SerenityStaticAssetsEnabled Condition="'$(SerenityStaticAssetsEnabled)' == '' And '$(StaticWebAssetsEnabled)' != 'true'">true</SerenityStaticAssetsEnabled>
      <_SerenityStaticAssetBasePath>$(StaticWebAssetBasePath.Trim('/'))</_SerenityStaticAssetBasePath>
      <_SerenityStaticAssetBasePath Condition="'$(_SerenityStaticAssetBasePath)' == ''">$(AssemblyName)</_SerenityStaticAssetBasePath>
      <_SerenityStaticAssetDefaultIncludes Condition="'$(SerenityStaticAssetIncludes)' == ''">true</_SerenityStaticAssetDefaultIncludes>
      <SerenityStaticAssetIncludes Condition="'$(SerenityStaticAssetIncludes)' == ''">wwwroot\**</SerenityStaticAssetIncludes>
      <!--
        same as the SDK's default Content items (output folders, *.user, project files, dot folders...) plus dot / temp files.
        node_modules etc. are added explicitly, as only the web / razor SDK adds them to DefaultItemExcludes
      -->
      <SerenityStaticAssetDefaultExcludes Condition="'$(SerenityStaticAssetDefaultExcludes)' == ''">$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);**\node_modules\**;**\jspm_packages\**;**\bower_components\**;wwwroot\**\.*;wwwroot\**\*.tmp;wwwroot\**\*~;wwwroot\**\Thumbs.db;wwwroot\**\desktop.ini</SerenityStaticAssetDefaultExcludes>
    </PropertyGroup>
  </Target>

  <!--
    called by referencing web apps on each referenced project, for serving while running from the build output.
    a project that uses static web assets instead returns an item with UsesStaticWebAssets=true, so that an app
    that has static web assets disabled can warn about it
  -->
  <Target Name="GetSerenityStaticAssetRoots" DependsOnTargets="_InitSerenityStaticAssets" Returns="@(_SerenityStaticAssetRoot)">
    <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\wwwroot')">
      <!-- the same patterns as GetSerenityStaticAssetFiles, so that files that are not published are not served either -->
      <_SerenityStaticAssetRoot Include="$(MSBuildProjectDirectory)\wwwroot\" BasePath="$(_SerenityStaticAssetBasePath)"
        Includes="$(SerenityStaticAssetIncludes)" Excludes="$(SerenityStaticAssetDefaultExcludes);$(SerenityStaticAssetExcludes)"
        WellKnown="$(_SerenityStaticAssetDefaultIncludes)" WellKnownExcludes="$(DefaultItemExcludes);$(SerenityStaticAssetExcludes)"
        Condition="'$(SerenityStaticAssetsEnabled)' == 'true'" />
      <_SerenityStaticAssetRoot Include="$(MSBuildProjectFullPath)" UsesStaticWebAssets="true" ProjectName="$(MSBuildProjectName)"
        Condition="'$(StaticWebAssetsEnabled)' == 'true'" />
    </ItemGroup>
  </Target>

  <!-- the files to publish / pack, with BasePath and AssetPath (path relative to the base path) metadata -->
  <Target Name="GetSerenityStaticAssetFiles" DependsOnTargets="_InitSerenityStaticAssets" Returns="@(_SerenityStaticAssetFile)">
    <ItemGroup Condition="'$(SerenityStaticAssetsEnabled)' == 'true'">
      <_SerenityStaticAssetFileCandidate Include="$(SerenityStaticAssetIncludes)" Exclude="$(SerenityStaticAssetDefaultExcludes);$(SerenityStaticAssetExcludes)" />
      <!-- like the SDK, keep wwwroot\.well-known (RFC 8615) although dot folders are excluded, unless includes are customized -->
      <_SerenityStaticAssetFileCandidate Include="wwwroot\.well-known\**" Exclude="$(DefaultItemExcludes);$(SerenityStaticAssetExcludes)"
        Condition="'$(_SerenityStaticAssetDefaultIncludes)' == 'true'" />
      <_SerenityStaticAssetFile Include="@(_SerenityStaticAssetFileCandidate->'%(FullPath)')" BasePath="$(_SerenityStaticAssetBasePath)"
        Condition="'@(_SerenityStaticAssetFileCandidate)' != ''" CompressionExcludePatterns="$(CompressionExcludePatterns)"
        AssetPath="$([MSBuild]::MakeRelative('$(MSBuildProjectDirectory)\wwwroot\', '%(_SerenityStaticAssetFileCandidate.FullPath)'))" />
      <_SerenityStaticAssetFileCandidate Remove="@(_SerenityStaticAssetFileCandidate)" />
    </ItemGroup>
  </Target>

  <!-- added through NuGet's extension point, so wwwroot item settings (e.g. Content with Pack=false) don't matter -->
  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_PackSerenityStaticAssets</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="_PackSerenityStaticAssets" DependsOnTargets="GetSerenityStaticAssetFiles"
          Condition="'$(OutputType)' != 'Exe'">
    <PropertyGroup>
      <_SerenityStaticAssetsPackProps>$(IntermediateOutputPath)serenitystaticassets\$(PackageId).props</_SerenityStaticAssetsPackProps>
      <!-- escaped, as WriteLinesToFile would otherwise split the patterns into separate lines at ; -->
      <_SerenityStaticAssetsPackExcludes>$([MSBuild]::Escape('$(CompressionExcludePatterns)').Trim('%3B'))</_SerenityStaticAssetsPackExcludes>
    </PropertyGroup>
    <WriteLinesToFile File="$(_SerenityStaticAssetsPackProps)" Overwrite="true" WriteOnlyWhenDifferent="true"
      Condition="'@(_SerenityStaticAssetFile)' != ''"
      Lines="&lt;Project&gt;;  &lt;ItemGroup&gt;;    &lt;SerenityStaticAssetRoot Include=&quot;%24(MSBuildThisFileDirectory)..\staticwebassets\&quot; BasePath=&quot;$(_SerenityStaticAssetBasePath)&quot; CompressionExcludePatterns=&quot;$(_SerenityStaticAssetsPackExcludes)&quot; /&gt;;  &lt;/ItemGroup&gt;;&lt;/Project&gt;" />
    <ItemGroup Condition="'@(_SerenityStaticAssetFile)' != ''">
      <TfmSpecificPackageFile Include="@(_SerenityStaticAssetFile)"
        PackagePath="$([System.IO.Path]::Combine('staticwebassets', $([System.IO.Path]::GetDirectoryName('%(_SerenityStaticAssetFile.AssetPath)'))))\" />
      <TfmSpecificPackageFile Include="$(_SerenityStaticAssetsPackProps)" PackagePath="buildTransitive\" />
      <FileWrites Include="$(_SerenityStaticAssetsPackProps)" />
    </ItemGroup>
  </Target>

  <!--
    SerenityStaticAssetRoot items of packages come from their buildTransitive props,
    the ones of referenced projects are added here
  -->
  <Target Name="ResolveSerenityStaticAssetRoots" AfterTargets="ResolveProjectReferences" Condition="'$(OutputType)' == 'Exe'">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)" Targets="GetSerenityStaticAssetRoots"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)"
             SkipNonexistentTargets="true" BuildInParallel="$(BuildInParallel)"
             Condition="'@(_MSBuildProjectReferenceExistent)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SerenityReferencedStaticAssetRoot" />
    </MSBuild>
    <ItemGroup>
      <SerenityStaticAssetRoot Include="@(_SerenityReferencedStaticAssetRoot)" Condition="'%(_SerenityReferencedStaticAssetRoot.UsesStaticWebAssets)' != 'true'" />
      <_SerenityStaticWebAssetsProject Include="@(_SerenityReferencedStaticAssetRoot)" Condition="'%(_SerenityReferencedStaticAssetRoot.UsesStaticWebAssets)' == 'true'" />
    </ItemGroup>
    <PropertyGroup>
      <_SerenityStaticAssetsManifestFile>$(IntermediateOutputPath)$(AssemblyName).serenitystaticassets.json</_SerenityStaticAssetsManifestFile>
    </PropertyGroup>
    <!-- written by a task, as patterns contain characters (* ;) that MSBuild item / line handling would interpret -->
    <WriteStaticAssetsManifestTask Roots="@(SerenityStaticAssetRoot)" File="$(_SerenityStaticAssetsManifestFile)"
      Condition="'@(SerenityStaticAssetRoot)' != ''" />
    <ItemGroup Condition="'@(SerenityStaticAssetRoot)' != ''">
      <None Include="$(_SerenityStaticAssetsManifestFile)" Link="$(AssemblyName).serenitystaticassets.json"
            CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
      <FileWrites Include="$(_SerenityStaticAssetsManifestFile)" />
    </ItemGroup>
  </Target>

  <!--
    when the app has static web assets disabled, files of packages / referenced projects that still use them
    are neither served nor published, so warn about them. packages declare their StaticWebAsset items in
    their props regardless of the app's setting. set SerenityStaticWebAssetsCheck to false to skip the check.
  -->
  <Target Name="_CheckSerenityStaticWebAssetsDisabled" AfterTargets="ResolveSerenityStaticAssetRoots"
          Condition="'$(OutputType)' == 'Exe' And '$(StaticWebAssetsEnabled)' != 'true' And '$(SerenityStaticWebAssetsCheck)' != 'false'">
    <ItemGroup>
      <_SerenityStaticWebAssetsPackage Include="%(StaticWebAsset.SourceId)" Condition="'%(StaticWebAsset.SourceType)' == 'Package'" />
    </ItemGroup>
    <Warning Code="SERSA001" Condition="'@(_SerenityStaticWebAssetsPackage)' != ''"
      Text="Package %(_SerenityStaticWebAssetsPackage.Identity) contains static web assets, but StaticWebAssetsEnabled is false for $(MSBuildProjectName), so its files are not served or published. Set StaticWebAssetsEnabled to true in $(MSBuildProjectFile) if you need them, or SerenityStaticWebAssetsCheck to false to hide this warning." />
    <Warning Code="SERSA002" Condition="'@(_SerenityStaticWebAssetsProject)' != ''"
      Text="Referenced project %(_SerenityStaticWebAssetsProject.ProjectName) uses static web assets, but StaticWebAssetsEnabled is false for $(MSBuildProjectName), so its wwwroot files are not served or published. Set StaticWebAssetsEnabled to false in %(_SerenityStaticWebAssetsProject.ProjectName) to serve them with Serenity static assets, or to true in $(MSBuildProjectFile)." />
  </Target>

  <!--
    referenced projects return their (filtered) file lists, package folders were already
    filtered while packing, so all their files are published
  -->
  <Target Name="_PublishSerenityStaticAssets" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="ResolveSerenityStaticAssetRoots"
          Condition="'$(OutputType)' == 'Exe'">
    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)" Targets="GetSerenityStaticAssetFiles"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)"
             SkipNonexistentTargets="true" BuildInParallel="$(BuildInParallel)"
             Condition="'@(_MSBuildProjectReferenceExistent)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SerenityStaticAssetPublishFile" />
    </MSBuild>
    <ItemGroup>
      <_SerenityPackageStaticAssetFile Include="%(SerenityStaticAssetRoot.FullPath)**\*"
        Condition="'%(SerenityStaticAssetRoot.MSBuildSourceProjectFile)' == ''"
        BasePath="%(SerenityStaticAssetRoot.BasePath)" AssetRoot="%(SerenityStaticAssetRoot.FullPath)"
        CompressionExcludePatterns="%(SerenityStaticAssetRoot.CompressionExcludePatterns)" />
      <_SerenityStaticAssetPublishFile Include="@(_SerenityPackageStaticAssetFile)" Condition="'@(_SerenityPackageStaticAssetFile)' != ''"
        AssetPath="$([MSBuild]::MakeRelative('%(_SerenityPackageStaticAssetFile.AssetRoot)', '%(_SerenityPackageStaticAssetFile.FullPath)'))" />
      <ResolvedFileToPublish Include="@(_SerenityStaticAssetPublishFile)"
        RelativePath="wwwroot\%(_SerenityStaticAssetPublishFile.BasePath)\%(_SerenityStaticAssetPublishFile.AssetPath)"
        CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <!--
    publish only compression of wwwroot files (the app's own and Serenity static assets), like the static web assets
    SDK does on publish. uses the same properties: PublishCompressionFormats (gzip;brotli by default, empty to disable),
    CompressionIncludePatterns / CompressionExcludePatterns (SDK defaults appended unless EnableDefaultCompressedItems
    is false). CompressionExcludePatterns of libraries also apply to their own files. existing .br / .gz files to
    publish (e.g. produced by the SDK when static web assets are enabled) are kept as is.
  -->
  <PropertyGroup>
    <SerenityBuildTasksPointer Condition="'$(SerenityBuildTasksPointer)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\buildtasks\current.txt</SerenityBuildTasksPointer>
    <SerenityBuildTasksAssembly Condition="'$(SerenityBuildTasksAssembly)' == '' And Exists('$(SerenityBuildTasksPointer)')">$([System.IO.File]::ReadAllText('$(SerenityBuildTasksPointer)').Trim())</SerenityBuildTasksAssembly>
    <_CompressStaticAssetsFromBuildTasks Condition="'$(SerenityBuildTasksAssembly)' != '' And Exists('$(SerenityBuildTasksAssembly)') And $([System.IO.File]::GetLastWriteTime('$(SerenityBuildTasksPointer)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)CompressStaticAssetsTask.cs').Ticks)">true</_CompressStaticAssetsFromBuildTasks>
  </PropertyGroup>
  <PropertyGroup>
    <_WriteStaticAssetsManifestFromBuildTasks Condition="'$(SerenityBuildTasksAssembly)' != '' And Exists('$(SerenityBuildTasksAssembly)') And $([System.IO.File]::GetLastWriteTime('$(SerenityBuildTasksPointer)').Ticks) &gt; $([System.IO.File]::GetLastWriteTime('$(MSBuildThisFileDirectory)WriteStaticAssetsManifestTask.cs').Ticks)">true</_WriteStaticAssetsManifestFromBuildTasks>
  </PropertyGroup>
  <UsingTask TaskName="WriteStaticAssetsManifestTask" AssemblyFile="$(SerenityBuildTasksAssembly)" Condition="'$(_WriteStaticAssetsManifestFromBuildTasks)' == 'true'" />
  <UsingTask TaskName="WriteStaticAssetsManifestTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll" Condition="'$(_WriteStaticAssetsManifestFromBuildTasks)' != 'true'">
    <ParameterGroup>
      <Roots ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <File ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)WriteStaticAssetsManifestTask.cs" />
    </Task>
  </UsingTask>
  <UsingTask TaskName="CompressStaticAssetsTask" AssemblyFile="$(SerenityBuildTasksAssembly)" Condition="'$(_CompressStaticAssetsFromBuildTasks)' == 'true'" />
  <UsingTask TaskName="CompressStaticAssetsTask" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll" Condition="'$(_CompressStaticAssetsFromBuildTasks)' != 'true'">
    <ParameterGroup>
      <Files ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <IntermediateDirectory ParameterType="System.String" Required="true" />
      <PatternRoot ParameterType="System.String" />
      <IncludePatterns ParameterType="System.String" />
      <ExcludePatterns ParameterType="System.String" />
      <Formats ParameterType="System.String" />
      <CompressedFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)CompressStaticAssetsTask.cs" />
    </Task>
  </UsingTask>

  <Target Name="_CompressSerenityPublishFiles" AfterTargets="ComputeResolvedFilesToPublishList" DependsOnTargets="_PublishSerenityStaticAssets"
          Condition="'$(OutputType)' == 'Exe'">
    <!-- same defaults as Microsoft.NET.Sdk.StaticWebAssets.Compression.targets, which is not imported when static web assets are disabled -->
    <PropertyGroup>
      <EnableDefaultCompressionFormats Condition="'$(EnableDefaultCompressionFormats)' == ''">true</EnableDefaultCompressionFormats>
      <PublishCompressionFormats Condition="'$(EnableDefaultCompressionFormats)' == 'true'">$(PublishCompressionFormats);gzip;brotli</PublishCompressionFormats>
      <CompressionIncludePatterns Condition="'$(EnableDefaultCompressedItems)' != 'false'">$(CompressionIncludePatterns);**/*.js;**/*.css;**/*.html;**/*.json;**/*.mjs;**/*.xml;**/*.htm;**/*.wasm;**/*.txt;**/*.dll;**/*.pdb;**/*.dat;**/*.jsx;**/*.markdown;**/*.md;**/*.webmanifest;**/*.bmp;**/*.svg;**/*.otf;**/*.art;**/*.cmx;**/*.cod;**/*.dib;**/*.ico;**/*.ief;**/*.pbm;**/*.pgm;**/*.pnm;**/*.ppm;**/*.ras;**/*.rf;**/*.rgb;**/*.tif;**/*.tiff;**/*.wbmp;**/*.xbm;**/*.xpm;**/*.xwd;**/*.aif;**/*.aifc;**/*.au;**/*.m3u;**/*.mid;**/*.midi;**/*.ra;**/*.ram;**/*.smd;**/*.smx;**/*.smz;**/*.wav;**/*.323;**/*.appcache;**/*.asm;**/*.bas;**/*.c;**/*.cnf;**/*.cpp;**/*.csv;**/*.disco;**/*.dlm;**/*.dtd;**/*.etx;**/*.h;**/*.hdml;**/*.htc;**/*.htt;**/*.hxt;**/*.ical;**/*.icalendar;**/*.ics;**/*.ifb;**/*.map;**/*.mno;**/*.odc;**/*.rtx;**/*.sct;**/*.sgml;**/*.tsv;**/*.uls;**/*.vbs;**/*.vcf;**/*.vcs;**/*.vml;**/*.wml;**/*.wmls;**/*.wsdl;**/*.xdr;**/*.xsd;**/*.xsf;**/*.xsl;**/*.xslt</CompressionIncludePatterns>
      <!-- conditions can't contain ; so computed here -->
      <_SerenityPublishCompressionFormatsCheck>$(PublishCompressionFormats.Replace(';', '').Trim())</_SerenityPublishCompressionFormatsCheck>
      <CompressionExcludePatterns Condition="'$(EnableDefaultCompressedItems)' != 'false'">$(CompressionExcludePatterns);**/*.gz;**/*.br;**/*.jpeg;**/*.jpg;**/*.png;**/*.gif;**/*.webp;**/*.woff;**/*.woff2;**/*.m4v;**/*.mov;**/*.movie;**/*.mp2;**/*.mp4;**/*.mp4v;**/*.mpa;**/*.mpe;**/*.mpeg;**/*.mpg;**/*.mpv2;**/*.ogg;**/*.ogv;**/*.webm;**/*.jfif;**/*.svgz;**/*.jpe;**/*.pnz;**/*.aac;**/*.adt;**/*.adts;**/*.m4a;**/*.mp3;**/*.oga;**/*.wax;**/*.wma</CompressionExcludePatterns>
    </PropertyGroup>
    <ItemGroup>
      <_SerenityCompressCandidate Include="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('/', '\').ToLowerInvariant().StartsWith('wwwroot\'))" />
    </ItemGroup>
    <CompressStaticAssetsTask Files="@(_SerenityCompressCandidate)" IntermediateDirectory="$(IntermediateOutputPath)serenitycompressed\"
      PatternRoot="wwwroot" IncludePatterns="$(CompressionIncludePatterns)" ExcludePatterns="$(CompressionExcludePatterns)" Formats="$(PublishCompressionFormats)"
      Condition="'@(_SerenityCompressCandidate)' != '' And '$(_SerenityPublishCompressionFormatsCheck)' != ''">
      <Output TaskParameter="CompressedFiles" ItemName="_SerenityCompressedFile" />
    </CompressStaticAssetsTask>
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_SerenityCompressedFile)" />
      <FileWrites Include="@(_SerenityCompressedFile)" />
      <_SerenityCompressCandidate Remove="@(_SerenityCompressCandidate)" />
    </ItemGroup>
  </Target>
</Project>
