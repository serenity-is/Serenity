@model Serenity.Extensions.ResetPasswordEmailModel
@inject Serenity.ITextLocalizer Localizer
@using Serenity.Extensions
@{
    Layout = "~/Areas/Serenity.Extensions/Shared/_EmailLayout.cshtml";
    var siteTitle = Localizer.TryGet("Navigation.SiteTitle");
    ViewData["Title"] = ResetPasswordFormTexts.EmailSubject.ToString(Localizer);
    string T(LocalText text, params object?[] args) => string.Format(System.Globalization.CultureInfo.CurrentCulture, text.ToString(Localizer), args);
    var button = new EmailButtonModel { Text = T(ResetPasswordEmailTexts.Button), Url = Model.ResetLink };
}
<p style="margin: 0 0 16px;">@T(ResetPasswordEmailTexts.Greeting, Model.DisplayName)</p>

<p style="margin: 0 0 16px;">@(string.IsNullOrEmpty(siteTitle) ? T(ResetPasswordEmailTexts.IntroNoSite) : T(ResetPasswordEmailTexts.Intro, siteTitle))</p>

<partial name="~/Areas/Serenity.Extensions/Shared/_EmailButton.cshtml" model="button" />

<p style="margin: 0 0 16px; font-size: 13px; color: #4b5563;">@T(ResetPasswordEmailTexts.Expires, Model.LinkHours)<br />@T(ResetPasswordEmailTexts.Ignore)</p>
