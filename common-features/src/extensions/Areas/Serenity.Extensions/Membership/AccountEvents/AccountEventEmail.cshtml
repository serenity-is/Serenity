@model Serenity.Extensions.AccountEventEmailModel
@inject Serenity.ITextLocalizer Localizer
@using Serenity.Extensions
@{
    var e = Model.Event;
    string T(LocalText text, params object?[] args) => string.Format(System.Globalization.CultureInfo.CurrentCulture, text.ToString(Localizer), args);
}
<html>
<head>
    <title>@Model.Subject</title>
</head>
<body>
    <p>@T(AccountEventEmailTexts.Greeting, string.IsNullOrEmpty(e.DisplayName) ? e.Username : e.DisplayName)</p>

    <p>@Model.Message</p>

    <p>
        @(e.IsSelf ? T(AccountEventEmailTexts.BySelf) : T(AccountEventEmailTexts.ByOther, string.IsNullOrEmpty(e.ActorDisplayName) ? e.ActorUsername : e.ActorDisplayName))<br />
        @T(AccountEventEmailTexts.When, e.Time.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture))
        @if (!string.IsNullOrEmpty(e.IPAddress))
        {
            <br />@T(AccountEventEmailTexts.Where, e.IPAddress)
        }
    </p>

    <p><b>@T(AccountEventEmailTexts.NotYou)</b></p>

    <p>@T(AccountEventEmailTexts.Signature, Model.SiteTitle)</p>
</body>
</html>
